# ==============================================================================
# MedCore Admin — MOH Oversight Portal (apps/admin) Environment Variables
# ==============================================================================
# Copy to apps/admin/.env.local for local development (port 3004).
# Connects to the shared PostgreSQL cluster for statewide MOH tables (moh_*).

# --- Shared PostgreSQL Cluster ------------------------------------------------
# Production (Vercel AWS RDS OIDC):
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/medcore-rds-oidc
# AWS_REGION=eu-north-1
# MEDCORE_AWS_DB_PGHOST=your-cluster.rds.amazonaws.com
# MEDCORE_AWS_DB_PGPORT=5432
# MEDCORE_AWS_DB_PGDATABASE=postgres
# MEDCORE_AWS_DB_PGUSER=postgres
# MEDCORE_AWS_DB_PGSSLMODE=require
#
# Local / Direct URL fallback:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medcore?sslmode=disable

# --- Statewide AI Epidemiological Intelligence (/api/moh/intelligence) --------
GEMINI_API_KEY=your-gemini-api-key

# --- Optional Central Hub URL -------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
