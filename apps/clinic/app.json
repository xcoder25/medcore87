{
  "expo": {
    "name": "MedCore Mobile",
    "slug": "medcore-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#030816",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#030816"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medcore.clinic",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan patient SHID QR cards, drug barcodes, and clinical wound photos.",
        "NSMicrophoneUsageDescription": "Record bedside clinical rounds for M87 Ambient AI SOAP documentation.",
        "NSFaceIDUsageDescription": "Unlock paused clinical PHI sessions and authenticate administrator actions."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#030816"
      },
      "package": "com.medcore.clinic",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
