# Paystack — public on client, secret on server only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Optional: default Paystack Terminal device id
NEXT_PUBLIC_PAYSTACK_TERMINAL_ID=

# Gemini (M87 AI) — set on Vercel env / local .env.local
NEXT_PUBLIC_GEMINI_API_KEY=

# MedGemma (optional) — self-hosted or Vertex proxy URL accepting JSON { prompt, image? }
# When empty, imaging AI uses Gemini medical fallback if NEXT_PUBLIC_GEMINI_API_KEY is set
NEXT_PUBLIC_MEDGEMMA_API_URL=

# Paystack webhook URL (Vercel): https://YOUR_DOMAIN/api/paystack/webhook
# PAYSTACK_SECRET_KEY already required for verify + webhook

# Firebase Admin (server only — staff Auth delete, no PIN needed)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or: FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of service account json>

# Onsite hospital hub (LAN) — set on hospital server deploy so blackouts fall back to local sync
# Example: http://10.0.0.5:4000  or  http://medcore-hub.local:4000
# NEXT_PUBLIC_API_URL=


# Aurora Postgres (Vercel AWS integration) — system of record
# MEDCORE_AWS_DB_PGHOST=aws-medcore87.cluster-xxx.us-east-1.rds.amazonaws.com
# MEDCORE_AWS_DB_PGPORT=5432
# MEDCORE_AWS_DB_PGDATABASE=postgres
# MEDCORE_AWS_DB_PGUSER=postgres
# MEDCORE_AWS_DB_PGPASSWORD=***
# MEDCORE_AWS_DB_PGSSLMODE=require
# Or single URL:
# DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require
