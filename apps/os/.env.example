# MedCore OS — Vercel / browser env (must be NEXT_PUBLIC_* to reach the client)

# WebSocket event bus (API server). On Vercel HTTPS you need wss:// not ws://
# Example after API is hosted: wss://api.yourdomain.com/ws
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# Optional REST API base (when modules are wired to server)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase Auth (test) — Email/Password must be enabled in Firebase Console
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAOLWLpM0vzIljUeXOnSQbppzuaHhfmXyI
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=naija-bites-1s3y1.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=naija-bites-1s3y1
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=naija-bites-1s3y1.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=667802678337
NEXT_PUBLIC_FIREBASE_APP_ID=1:667802678337:web:2018efd10f6ca9dbe742c0

# Firestore is used automatically once Firebase is configured (same project as Auth).
# Enable Cloud Firestore in Firebase Console → Build → Firestore Database.
