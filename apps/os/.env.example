# ==============================================================================
# MedCore OS (apps/os) Environment Variables
# ==============================================================================
# Copy to apps/os/.env.local for local development (port 3003).
# NEVER expose private keys with NEXT_PUBLIC_.

# --- Database (PostgreSQL / AWS RDS Aurora) -----------------------------------
# Priority order in apps/os/src/lib/db/postgres.ts:
# 1. AWS_ROLE_ARN (+ PGHOST/PGUSER/PGDATABASE) -> Vercel AWS OIDC IAM auth
# 2. AWS_RDS_PASSWORD -> Explicit password override
# 3. DATABASE_URL / MEDCORE_DATABASE_URL -> Standard Postgres URL
# 4. PGHOST + PGPASSWORD -> Legacy env vars
# 5. AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY -> IAM access key RDS signer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medcore?sslmode=disable
# MEDCORE_AWS_DB_PGHOST=your-cluster.rds.amazonaws.com
# MEDCORE_AWS_DB_PGPORT=5432
# MEDCORE_AWS_DB_PGDATABASE=postgres
# MEDCORE_AWS_DB_PGUSER=postgres
# MEDCORE_AWS_DB_PGSSLMODE=require

# --- Authentication, Session Signing & Scheduled Ops --------------------------
# High-entropy secret (>= 32 chars) used to HMAC-SHA256 sign session cookies & MFA tokens
MEDCORE_SESSION_SECRET=replace-with-32-byte-random-hex-secret
# Fallback alias also checked by serverSession.ts: NEXTAUTH_SECRET=
# Server-to-server administrative endpoints (/api/staff/create, delete-auth, flush-facility)
ADMIN_API_SECRET=replace-with-strong-admin-api-secret
MEDCORE_ADMIN_API_SECRET=replace-with-strong-admin-api-secret
# Vercel Cron bearer secret guarding GET/POST /api/cron/daily-ops
CRON_SECRET=replace-with-cron-bearer-secret

# --- Google Gemini AI Proxy (SERVER-ONLY) -------------------------------------
# Used by /api/gemini and /api/ai/* (clinical-safety, digitize-fhir, patient-brief, scribe, transcribe, vision-clinical)
GEMINI_API_KEY=your-gemini-api-key
# Accepted aliases: GOOGLE_GEMINI_API_KEY / GOOGLE_API_KEY / GOOGLE_GENERATIVE_AI_API_KEY

# Optional self-hosted/Vertex imaging proxy fallback
NEXT_PUBLIC_MEDGEMMA_API_URL=

# --- AWS S3 Private Clinical Object Storage (SERVER-ONLY) ---------------------
MEDCORE_S3_BUCKET=your-private-medcore-hipaa-bucket
MEDCORE_S3_REGION=eu-west-1
# MEDCORE_S3_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/medcore-s3-oidc
MEDCORE_S3_ACCESS_KEY_ID=
MEDCORE_S3_SECRET_ACCESS_KEY=
# Enable avatar/photo cloud uploads in client UI (routes through /api/storage/*)
NEXT_PUBLIC_ENABLE_STAFF_PHOTO_STORAGE=true

# --- AWS Rekognition Facial Biometrics & Live Liveness (SERVER-ONLY) ----------
# Requires a Rekognition-supported region (e.g. eu-west-1, us-east-1)
MEDCORE_REKOGNITION_REGION=eu-west-1
# MEDCORE_REKOGNITION_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/medcore-rekognition-oidc
MEDCORE_REKOGNITION_ACCESS_KEY_ID=
MEDCORE_REKOGNITION_SECRET_ACCESS_KEY=
MEDCORE_REKOGNITION_LIVENESS_ENABLED=true
# MEDCORE_REKOGNITION_LIVENESS_ROLE_ARN=arn:aws:iam::123456789012:role/medcore-liveness-role
MEDCORE_REKOGNITION_LIVENESS_MIN_CONFIDENCE=85

# --- Firebase Client & Admin SDK ----------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only Firebase Admin JSON for /api/staff/create & delete-auth
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Or raw JSON string: FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Payments: Paystack & AkwaRemit -------------------------------------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_PAYSTACK_TERMINAL_ID=
# PAYSTACK_TERMINAL_ID=

AKWAREMIT_ENV=sandbox
AKWAREMIT_MERCHANT_ID=
AKWAREMIT_API_KEY=
AKWAREMIT_SECRET_KEY=
AKWAREMIT_WEBHOOK_SECRET=

# --- Health Insurance & Interoperability (AKSHIA / DHIS2) ---------------------
AKSHIA_API_URL=
AKSHIA_API_KEY=
DHIS2_BASE_URL=
DHIS2_USER=
DHIS2_PASSWORD=

# --- Communications: Staff 2FA Email OTP, SMS & WhatsApp Triage ---------------
# Resend is used when set; EMAIL_WEBHOOK_URL is an optional custom HTTP fallback
RESEND_API_KEY=
RESEND_FROM=MedCore OS <noreply@medcore.example>
EMAIL_WEBHOOK_URL=

SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=MedCore

# Meta WhatsApp Cloud API webhook (/api/whatsapp/triage)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional Real-Time EventBridge & External Merkle Anchoring ---------------
EVENTBRIDGE_BUS_NAME=
MERKLE_ANCHOR_WEBHOOK_URL=
MERKLE_ANCHOR_API_KEY=

# --- Optional On-Prem LAN Hub Bridge ------------------------------------------
# Omit when running serverless cloud-only; set on hospital intranet (e.g. http://10.0.0.5:4000)
NEXT_PUBLIC_API_URL=
