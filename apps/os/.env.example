# Paystack — public on client, secret on server only
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Optional: default Paystack Terminal device id
NEXT_PUBLIC_PAYSTACK_TERMINAL_ID=

# Gemini (M87 AI) — MUST be a server-only env variable (no NEXT_PUBLIC_ prefix!)
# Set GEMINI_API_KEY (not NEXT_PUBLIC_) in Vercel env or .env.local
# The app routes all Gemini calls through /api/gemini server proxy — key never reaches the browser.
# GEMINI_API_KEY=AIzaSy...
# GOOGLE_GEMINI_API_KEY=AIzaSy...  (alternative name, same behaviour)

# MedGemma (optional) — self-hosted or Vertex proxy URL accepting JSON { prompt, image? }
# When empty, imaging AI falls back to Gemini via the server proxy above
NEXT_PUBLIC_MEDGEMMA_API_URL=

# Paystack webhook URL (Vercel): https://YOUR_DOMAIN/api/paystack/webhook
# PAYSTACK_SECRET_KEY already required for verify + webhook

# Firebase CLIENT config (safe to expose — these are public identifiers, NOT secret keys)
# Copy from your Firebase Console → Project Settings → Your apps → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only — staff Auth delete, no PIN needed)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or: FIREBASE_SERVICE_ACCOUNT_BASE64=<base64 of service account json>

# Admin API secret — SERVER-ONLY (never use NEXT_PUBLIC_ prefix!)
# Set this in Vercel env as ADMIN_API_SECRET or MEDCORE_ADMIN_API_SECRET
# ADMIN_API_SECRET=long-random-secret-here

# Onsite hospital hub (LAN) — set on hospital server deploy so blackouts fall back to local sync
# Example: http://10.0.0.5:4000  or  http://medcore-hub.local:4000
# NEXT_PUBLIC_API_URL=


# Aurora Postgres (Vercel AWS integration) — system of record
# MEDCORE_AWS_DB_PGHOST=aws-medcore87.cluster-xxx.us-east-1.rds.amazonaws.com
# MEDCORE_AWS_DB_PGPORT=5432
# MEDCORE_AWS_DB_PGDATABASE=postgres
# MEDCORE_AWS_DB_PGUSER=postgres
# MEDCORE_AWS_DB_PGPASSWORD=***
# MEDCORE_AWS_DB_PGSSLMODE=require
# Or single URL:
# DATABASE_URL=postgresql://user:pass@host:5432/postgres?sslmode=require
