# ==============================================================================
# MedCore Platform — Monorepo Environment Template (Copy to target app .env.local)
# ==============================================================================
# NEVER commit real API keys, service account JSONs, or production DB passwords.
# App-specific templates also live in apps/os/.env.example and apps/admin/.env.example.

# --- Runtime & App URLs -------------------------------------------------------
NODE_ENV=development
PORT=4000
# Local LAN hub URL or API server URL (optional; omit when running standalone serverless)
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- PostgreSQL / AWS RDS Aurora (System of Record) ---------------------------
# Option A (Production on Vercel + AWS RDS OIDC — recommended):
# AWS_ROLE_ARN=arn:aws:iam::123456789012:role/medcore-rds-oidc
# AWS_REGION=eu-north-1
# MEDCORE_AWS_DB_PGHOST=your-cluster.rds.amazonaws.com
# MEDCORE_AWS_DB_PGPORT=5432
# MEDCORE_AWS_DB_PGDATABASE=postgres
# MEDCORE_AWS_DB_PGUSER=postgres
# MEDCORE_AWS_DB_PGSSLMODE=require
#
# Option B (Local PostgreSQL or direct connection string):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medcore?sslmode=disable

# --- Session, Admin & Audit Cryptography (SERVER-ONLY) ------------------------
# Generate 32+ random bytes (e.g., `openssl rand -hex 32`). Required in production!
MEDCORE_SESSION_SECRET=replace-with-32-byte-random-hex-secret
ADMIN_API_SECRET=replace-with-strong-admin-api-secret
CRON_SECRET=replace-with-vercel-cron-bearer-secret
# Express hub security (services/api-server):
MEDCORE_AUDIT_HMAC_SECRET=replace-with-audit-hmac-secret
MEDCORE_ENCRYPTION_MASTER_KEY=replace-with-32-byte-aes-master-key
MEDCORE_SURVEILLANCE_SALT=replace-with-epidemiology-salt

# --- Google Gemini AI Proxy (SERVER-ONLY — never use NEXT_PUBLIC_) ------------
GEMINI_API_KEY=your-gemini-api-key

# --- AWS S3 Clinical Media Storage (SERVER-ONLY) ------------------------------
MEDCORE_S3_BUCKET=your-private-medcore-hipaa-bucket
MEDCORE_S3_REGION=eu-west-1
# Use either OIDC role ARN (recommended) or scoped IAM keys:
# MEDCORE_S3_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/medcore-s3-oidc
MEDCORE_S3_ACCESS_KEY_ID=
MEDCORE_S3_SECRET_ACCESS_KEY=

# --- AWS Rekognition Staff Biometrics 2FA (SERVER-ONLY) -----------------------
# Must target a Rekognition-enabled region (e.g., eu-west-1 or us-east-1)
MEDCORE_REKOGNITION_REGION=eu-west-1
# MEDCORE_REKOGNITION_ROLE_ARN=arn:aws:iam::123456789012:role/medcore-rekognition-oidc
MEDCORE_REKOGNITION_ACCESS_KEY_ID=
MEDCORE_REKOGNITION_SECRET_ACCESS_KEY=
MEDCORE_REKOGNITION_LIVENESS_ENABLED=true
MEDCORE_REKOGNITION_LIVENESS_MIN_CONFIDENCE=85

# --- Firebase Client & Admin SDK ----------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only Firebase Admin JSON (raw JSON or base64 encoded):
FIREBASE_SERVICE_ACCOUNT_BASE64=

# --- Revenue, Insurance & Public Health Integrations (SERVER-ONLY secrets) ----
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_PAYSTACK_TERMINAL_ID=

AKWAREMIT_ENV=sandbox
AKWAREMIT_MERCHANT_ID=
AKWAREMIT_API_KEY=
AKWAREMIT_SECRET_KEY=
AKWAREMIT_WEBHOOK_SECRET=

AKSHIA_API_URL=
AKSHIA_API_KEY=

DHIS2_BASE_URL=
DHIS2_USER=
DHIS2_PASSWORD=

# --- Notifications, OTP Email, SMS & WhatsApp Triage --------------------------
RESEND_API_KEY=
RESEND_FROM=MedCore OS <noreply@medcore.example>
EMAIL_WEBHOOK_URL=

SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=MedCore

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Optional Zero-PHI Merkle Blockchain Anchoring ----------------------------
MERKLE_ANCHOR_WEBHOOK_URL=
MERKLE_ANCHOR_API_KEY=
