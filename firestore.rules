rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pilot rules: Hospital OS uses badge/PIN + Firebase Auth hybrid.
    // Tighten later once every session always has request.auth.

    match /facilities/{facilityId} {
      allow read, write: if true;
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Cross-facility notification inbox (root collection)
    match /networkNotifications/{id} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
